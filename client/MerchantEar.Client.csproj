<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MerchantEar</AssemblyName>
    <RootNamespace>MerchantEar.Client</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <!-- COM interop for WASAPI process loopback must not be trimmed -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- A release is one file: the .NET runtime and the site inside, compressed; nothing to install -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- window capture and JPEG; the package instead of the whole Windows Desktop runtime keeps the exe smaller -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The site (web/) is built into the exe and served on http://localhost:PORT/ -->
    <EmbeddedResource Include="..\web\**\*" Exclude="..\web\_debug\**;..\web\deploy\**;..\web\**\README*.md;..\web\config.js"
                      LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
