<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- System.Drawing (window capture, JPEG) comes with the Windows Desktop runtime -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AbiKaluvan.Client</AssemblyName>
    <RootNamespace>AbiKaluvan.Client</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.3.5</Version>
    <!-- COM interop for WASAPI process loopback must not be trimmed -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
